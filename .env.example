# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Local:  postgres://postgres:postgres@localhost:5432/wecheaptours
# Vercel: add a Postgres database (e.g. Neon) from the Vercel Marketplace;
#         it sets DATABASE_URL for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wecheaptours

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin panel ───────────────────────────────────────────────────────
# Long random string used to sign admin sessions: `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@wecheaptours.com
ADMIN_PASSWORD=ChangeMe123!

# ── Email (any SMTP provider: Gmail, Zoho, Brevo, Resend SMTP, SES…) ──
# Leave SMTP_HOST empty in development: emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="WeCheapTours <bookings@wecheaptours.com>"
# Where new booking and enquiry alerts are sent
NOTIFY_EMAIL=bookings@wecheaptours.com

# ── Cloudinary (image uploads from the admin panel) ───────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wecheaptours
