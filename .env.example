# Every variable is validated at startup by src/config/env.ts: a missing or wrong value
# stops `next dev` / `next build` with a clear list.

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Local:  postgres://postgres:postgres@localhost:5432/wecheaptours
# Vercel: add a Postgres database (e.g. Neon) from the Vercel Marketplace; it sets DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wecheaptours
# Hosted databases are reached over verified TLS. Only for a private CA, paste its PEM here:
# DATABASE_CA_CERT=
# DATABASE_POOL_MAX=5

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Secrets (each at least 32 characters: `openssl rand -base64 32`) ──
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Signs guest booking links; falls back to AUTH_SECRET. Changing it breaks existing links.
# BOOKING_LINK_SECRET=
# Required in production: Vercel Cron sends it to /api/cron/*
CRON_SECRET=change-me-to-another-long-random-string-32

# ── Admin panel ───────────────────────────────────────────────────────
# First admin account (role: owner), created by `npm run db:seed`
ADMIN_EMAIL=admin@wecheaptours.com
ADMIN_PASSWORD=ChangeMe123!

# ── Email (any SMTP provider) ─────────────────────────────────────────
# Required in production: admins sign in with a code sent by email.
# Development: leave SMTP_HOST empty to write emails to the log, or run `npm run mail:dev`
# and use SMTP_HOST=localhost SMTP_PORT=1025 SMTP_USER=dev SMTP_PASSWORD=dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="WeCheapTours <bookings@wecheaptours.com>"
NOTIFY_EMAIL=bookings@wecheaptours.com

# ── Cloudinary (image uploads from the admin panel) ───────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wecheaptours
# A *signed* upload preset (Cloudinary → Settings → Upload): max file size 10 MB, formats jpg,png,webp,avif,
# optionally an incoming transformation that limits images to 2560 px.
CLOUDINARY_UPLOAD_PRESET=

# ── Payments (optional): both or neither ──────────────────────────────
# Webhook endpoint: https://<your domain>/api/webhooks/stripe (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bot protection (optional): Cloudflare Turnstile ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Monitoring (optional) ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# For source-map upload during `next build` (CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# LOG_LEVEL=info           # fatal|error|warn|info|debug|trace|silent
# LOG_FORMAT=json          # force JSON logs in development

# ── Behaviour switches ────────────────────────────────────────────────
# CSP_REPORT_ONLY=true     # report CSP violations without blocking (for a trial week)
# FX_SYNC=on               # refresh display exchange rates daily from FX_RATES_URL
# FX_RATES_URL=https://open.er-api.com/v6/latest/USD
# RETENTION_YEARS=3        # guest data is blanked this many years after travel
