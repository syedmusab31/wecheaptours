{
  "name": "wecheaptours",
  "version": "1.0.0",
  "private": true,
  "description": "WeCheapTours \u2014 Egypt & Jordan tours, cruises, transfers and stays. Next.js + Node.js + PostgreSQL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:upgrade": "tsx scripts/upgrade/2026-11-domain-model.ts && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "prepare": "husky || true",
    "mail:dev": "tsx scripts/dev/mail-sink.ts",
    "admin:recover": "tsx scripts/admin/recover-access.ts",
    "db:baseline": "tsx scripts/db/baseline.ts",
    "vercel-build": "npm run db:migrate && next build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@sentry/nextjs": "^9.47.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "^15.3.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
